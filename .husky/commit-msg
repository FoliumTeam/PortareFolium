#!/bin/sh
# Conventional commit 형식 검사 (feat:, fix:, docs: 등)
if ! pnpm exec commitlint --edit "$1" 2>/dev/null; then
    echo "커밋 메시지가 규칙에 맞지 않습니다. type(예: feat, fix, docs)과 제목을 사용해 주세요."
    exit 1
fi

node scripts/check-version-lifecycle.mjs "$1"

# AI·bot 공동 작성자 표시 차단 (.agents/directives/04-workflow.md)
node scripts/check-agent-attribution.mjs "$1"
